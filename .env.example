# Cloudflare R2 설정
# 이 파일을 .env로 복사하고 실제 값을 입력하세요
# cp .env.example .env

# R2 Access Key ID
R2_ACCESS_KEY=your-access-key-here

# R2 Secret Access Key
R2_SECRET_KEY=your-secret-key-here

# R2 Endpoint URL
# 형식: https://{account-id}.r2.cloudflarestorage.com
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# R2 Bucket 이름
R2_BUCKET=your-bucket-name
# 같은 R2 계정에서 여러 버킷을 순회하려면 R2_BUCKET 대신 쉼표로 구분해서 설정하세요.
# R2_BUCKETS=bucket-a,bucket-b,bucket-c

# --- 서버 ---
# 포트 (선택사항, 기본값: 4000)
# SERVER_PORT=4000
# HTTP Read/Write 타임아웃(초) (선택사항, 기본값: 30)
# SERVER_TIMEOUT_SECONDS=30

# --- 이미지 변환 ---
# 변환 대상 확장자, 쉼표 구분 (선택사항, 기본값: jpeg,jpg,png,gif,bmp,tiff)
# CONVERSION_FORMATS=jpeg,jpg,png,gif,bmp,tiff
# WebP 품질 0-100 (선택사항, 기본값: 85)
# CONVERSION_QUALITY=85
# 최대 이미지 크기(MB) (선택사항, 기본값: 50)
# CONVERSION_MAX_SIZE_MB=50

# --- 리사이즈 프리셋 ---
# 형식: 이름:폭x높이, 쉼표 구분 (선택사항, 비어 있으면 프리셋 없음)
# 여기서 지정한 프리셋만 API에서 사용 가능
# RESIZE_PRESETS=thumbnail:150x150,medium:800x800,large:1920x1920

# --- 크론 배치 ---
# Crontab 표현식 (선택사항, 기본값: 0 2 * * *)
# CRON_SCHEDULE=0 2 * * *
# 크론 활성화 (선택사항, true/false 또는 1/0)
# CRON_ENABLED=true

# --- 웹훅 ---
# 배치 완료 시 bulk 웹훅 전송 URL (선택사항, 설정 시 배치 종료마다 POST)
# WEBHOOK_URL=https://your-server.com/webhook/conversion-batch

# 웹훅 실패 시 파일 저장 후 주기 재전송 (WEBHOOK_URL 설정 시 유효)
# WEBHOOK_RETRY_ENABLED=true
# WEBHOOK_RETRY_INTERVAL_MINUTES=5
# WEBHOOK_MAX_RETRIES=5
# WEBHOOK_PENDING_DIR=data/webhook_pending
